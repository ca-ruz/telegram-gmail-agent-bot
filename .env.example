# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# Google Calendar Configuration
GOOGLE_CALENDAR_ID=your_gmail_or_calendar_id_here
ENABLE_CALENDAR_POLLING=false

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1536

# Coffee Host Reminders
COFFEE_HOSTS_FILE=data/coffee_hosts.json
COFFEE_HOST_SCHEDULE_FILE=data/coffee_host_schedule.json
COFFEE_HOST_REMINDER_RULES=7d,1d
COFFEE_DEFAULT_START_TIME=11:00
COFFEE_DEFAULT_VENUE=your_default_coffee_shop
ENABLE_COFFEE_HOST_REMINDERS=true

# Manual Event Promos
MANUAL_PROMOS_FILE=data/manual_promos.json
ENABLE_MANUAL_PROMO_REMINDERS=true
